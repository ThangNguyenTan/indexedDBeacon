{
  "manifest_version": 3,
  "name": "IndexedDBeacon - IndexedDB Explorer & Editor",
  "version": "1.0.0",
  "description": "High-performance DevTools extension to inspect, query, edit, export, import and manage IndexedDB databases with zero permissions.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "devtools_page": "devtools/devtools.html",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "IndexedDBeacon",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "indexed-dbeacon@thatnguyen.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
